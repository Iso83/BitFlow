#include <BitFlow/core/expression/Expr.h>
#include <BitFlow/core/expression/OpInfo.h>
#include <BitFlow/io/ExprLatex.h>
#include <sstream>
#include <BitFlow/io/helper/Exception.h>

namespace BitFlow::IO {

using namespace BitFlow::Core::Expression;
using namespace BitFlow::Core::Ids;

static std::string OpToLatex(OpType op) {
    switch (op) {
    case OpType::Add:
        return "+";

    case OpType::Sub:
        return "-";

    case OpType::Mul:
        return "\\cdot";

    case OpType::Div:
        return "/";

    case OpType::Mod:
        return "\\bmod";

    case OpType::And:
        return "\\mathbin{\\&}";

    case OpType::Or:
        return "|";

    case OpType::Xor:
        return "\\oplus";

    case OpType::Shl:
        return "\\ll";

    case OpType::Shr:
        return "\\gg";

    case OpType::Not:
        return "\\sim";

    default:
        BF_IO_THROW("Missing latex operator");
    }
}

static bool NeedsParens(const ExprStore* store, ExprId parent, ExprId child, bool isRightChild) {
    const Expr& p = (*store)[parent];
    const Expr& c = (*store)[child];

    if ((p.op == OpType::Shl || p.op == OpType::Shr) && (c.op == OpType::Add || c.op == OpType::Sub))
        return true;

    return RequiresParentheses(p.op, c.op, isRightChild);
}

static void WriteLatex(std::ostringstream& out, const ExprStore* store, ExprId id, const ExprNameMap* names);

static void WriteUnary(std::ostringstream& out, const ExprStore* store, ExprId parent, ExprId inner,
                       const ExprNameMap* names, const std::string& symbol, bool trailingSpace = false) {

    out << symbol;

    if (trailingSpace)
        out << " ";

    const bool parens = NeedsParens(store, parent, inner, false);

    if (parens)
        out << "(";

    WriteLatex(out, store, inner, names);

    if (parens)
        out << ")";
}

static void WriteBinaryFunction(std::ostringstream& out, const ExprStore* store, ExprId parent, ExprId lhs, ExprId rhs,
                                const ExprNameMap* names, const std::string& name) {

    out << name << "(";

    bool lhsParens = NeedsParens(store, parent, lhs, false);

    if (lhsParens)
        out << "(";

    WriteLatex(out, store, lhs, names);

    if (lhsParens)
        out << ")";

    out << ", ";

    bool rhsParens = NeedsParens(store, parent, rhs, true);

    if (rhsParens)
        out << "(";

    WriteLatex(out, store, rhs, names);

    if (rhsParens)
        out << ")";

    out << ")";
}

static void WriteLatex(std::ostringstream& out, const ExprStore* store, ExprId id, const ExprNameMap* names) {

    const Expr& expr = (*store)[id];

    switch (expr.op) {

    case OpType::Const:
        out << expr.knownValue;
        return;

    case OpType::Var: {
        if (names) {
            auto it = names->find(id);

            if (it != names->end()) {
                out << it->second;
                return;
            }
        }

        out << "v" << id.value();
        return;
    }

    case OpType::Not:
        WriteUnary(out, store, id, expr.inputs[0], names, OpToLatex(expr.op), true);
        return;

    case OpType::Neg:
        WriteUnary(out, store, id, expr.inputs[0], names, "-");
        return;

    case OpType::RotL:
        WriteBinaryFunction(out, store, id, expr.inputs[0], expr.inputs[1], names, "\\operatorname{rotl}");
        return;

    case OpType::RotR:
        WriteBinaryFunction(out, store, id, expr.inputs[0], expr.inputs[1], names, "\\operatorname{rotr}");
        return;

    case OpType::Pow: {
        const ExprId base = expr.inputs[0];
        const ExprId exponent = expr.inputs[1];

        const bool baseParens = NeedsParens(store, id, base, false);

        if (baseParens)
            out << "(";

        WriteLatex(out, store, base, names);

        if (baseParens)
            out << ")";

        out << "^{";
        WriteLatex(out, store, exponent, names);
        out << "}";

        return;
    }

    default:
        break;
    }

    if (expr.inputs.size() != 2)
        BF_IO_THROW("Unsupported expression shape in ToLatex");

    const ExprId left = expr.inputs[0];
    const ExprId right = expr.inputs[1];

    const bool leftParens = NeedsParens(store, id, left, false);

    const bool rightParens = NeedsParens(store, id, right, true);

    if (leftParens)
        out << "(";

    WriteLatex(out, store, left, names);

    if (leftParens)
        out << ")";

    out << " " << OpToLatex(expr.op) << " ";

    if (rightParens)
        out << "(";

    WriteLatex(out, store, right, names);

    if (rightParens)
        out << ")";

    return;
}

std::string ToLatex(const ExprStore* store, ExprId root, const ExprNameMap& names) {

    std::ostringstream out;

    WriteLatex(out, store, root, &names);

    return out.str();
}

std::string ToLatex(ExprRef root, const ExprNameMap& names) {

    return ToLatex(root.store, root.id, names);
}

} // namespace BitFlow::IO